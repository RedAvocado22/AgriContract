@startuml fig12_class_dispute
!include vp-style.iuml

package "contract-service" {
  class MilestonePage <<boundary>> {
    + flagIssue(issue : IssueType, evidence : File) : void
    + respondToFlag(decision : FlagResponse) : void
  }
  class MilestoneController <<control>> {
    + flag(mid : UUID, req : FlagRequest) : void
    + respond(mid : UUID, req : RespondRequest) : void
  }
  class FlagMilestoneIssueUseCase <<control>> {
    + execute(cmd : FlagIssueCommand) : void
  }
  class RespondToMilestoneFlagUseCase <<control>> {
    + execute(cmd : RespondFlagCommand) : void
  }
  class DisputeRoutingService <<control>> {
    + route(milestone : Milestone, terms : InspectionTerms) : InspectionTier
  }
  class ReportConfirmedConsumer <<control>> {
    + on(event : Map) : void
  }
  class ApplyInspectionResultUseCase <<control>> {
    + execute(cmd : ApplyResultCommand) : void
    - verifyResultHash(result : InspectionSettlementResultV1) : void
  }
  class QualityDispositionCalculator <<control>> {
    + evaluate(spec : QualitySpec, metrics : ActualMetrics) : QualityDisposition
  }
  class RemedyCalculator <<control>> {
    + calculate(decision : AttributionDecision, profile : LegalProfile) : RemedyDecision
  }
  class Milestone <<entity>> {
    + flag(issue : IssueType) : void
    + contest() : void
  }
  class BreachCase <<entity>> {
    - status : BreachCaseStatus
    - contestStatus : ContestStatus
    - contestDeadline : Instant [0..1]
    + BreachCase(milestoneId : UUID, reason : BreachReason)
    + resolve(decision : AttributionDecision) : void
  }
  class AttributionDecision <<entity>> {
    - decisionSource : DecisionSource
    - finalBreachingRole : Role [0..1]
    - qualityDisposition : QualityDisposition [0..1]
    + AttributionDecision(source : DecisionSource, role : Role, disposition : QualityDisposition)
  }
  class RemedyDecision <<entity>> {
    - penaltyEligible : boolean
    - reputationEligible : boolean
  }
  class RemedyLeg <<entity>> {
    - remedyLegId : UUID
    - remedyType : RemedyType
    - amount : Money
  }
}

interface MessageBroker <<boundary>> {
  + publish(event : EventEnvelope) : void
}

package "inspection-service" {
  class InspectionPage <<boundary>> {
    + submitReport(metrics : ActualMetrics, file : File) : void
  }
  interface UserPort <<boundary>> {
    + listEligibleInspectors() : List<UUID>
  }
  class InspectionController <<control>> {
    + submitReport(id : UUID, req : SubmitReportRequest) : void
  }
  class AssignInspectorUseCase <<control>> {
    + execute(cmd : AssignCommand) : void
    - pickRandom(candidates : List<UUID>) : UUID
  }
  class SubmitInspectionReportUseCase <<control>> {
    + execute(cmd : SubmitReportCommand) : void
    - computeHashes(result : InspectionSettlementResultV1) : ReportHashes
  }
  class InspectionAssignment <<entity>> {
    + InspectionAssignment(milestoneId : UUID, inspectorId : UUID)
    + end() : void
  }
  class InspectionReport <<entity>> {
    - resultHash : String
    - reportHash : String
    + InspectionReport(assignment : UUID, result : InspectionSettlementResultV1)
  }
}

package "escrow-service / reputation-service" {
  class RemedyFinalizedConsumer <<control>> {
    + on(event : Map) : void
  }
}

MilestonePage --> MilestoneController
MilestoneController --> FlagMilestoneIssueUseCase
MilestoneController --> RespondToMilestoneFlagUseCase
FlagMilestoneIssueUseCase --> Milestone
FlagMilestoneIssueUseCase ..> BreachCase : <<create>>
RespondToMilestoneFlagUseCase --> DisputeRoutingService
RespondToMilestoneFlagUseCase --> Milestone
RespondToMilestoneFlagUseCase --> MessageBroker : publishes
ReportConfirmedConsumer --> MessageBroker : consumes
ReportConfirmedConsumer --> ApplyInspectionResultUseCase
ApplyInspectionResultUseCase --> QualityDispositionCalculator
ApplyInspectionResultUseCase --> RemedyCalculator
ApplyInspectionResultUseCase --> BreachCase
ApplyInspectionResultUseCase ..> AttributionDecision : <<create>>
ApplyInspectionResultUseCase --> MessageBroker : publishes
BreachCase "1" -- "0..1" AttributionDecision : resolved by
AttributionDecision "1" -- "0..1" RemedyDecision : produces
RemedyDecision "1" *-- "1..*" RemedyLeg : legs
InspectionPage --> InspectionController
InspectionController --> SubmitInspectionReportUseCase
AssignInspectorUseCase --> MessageBroker : consumes
AssignInspectorUseCase --> UserPort
AssignInspectorUseCase ..> InspectionAssignment : <<create>>
SubmitInspectionReportUseCase --> InspectionAssignment
SubmitInspectionReportUseCase ..> InspectionReport : <<create>>
SubmitInspectionReportUseCase --> MessageBroker : publishes
RemedyFinalizedConsumer --> MessageBroker : consumes
Milestone -[hidden]-> ReportConfirmedConsumer
DisputeRoutingService -[hidden]-> ReportConfirmedConsumer
RemedyLeg -[hidden]-> InspectionPage
RemedyLeg -[hidden]-> AssignInspectorUseCase
InspectionReport -[hidden]-> RemedyFinalizedConsumer
@enduml
