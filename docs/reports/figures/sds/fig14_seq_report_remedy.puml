@startuml fig14_seq_report_remedy
!include vp-style.iuml
autonumber "0:"
hide footbox

actor "Inspector" as inspector
boundary ":Inspection\nPage" as page
control ":Inspection\nController" as ctl
control ":SubmitInspection\nReportUseCase" as submit
entity ":Inspection\nAssignment" as assignment
boundary ":Message\nBroker" as mq
control ":ReportConfirmed\nConsumer" as cons
control ":ApplyInspection\nResultUseCase" as apply
control ":QualityDisposition\nCalculator" as qdc
control ":Remedy\nCalculator" as rc
entity ":BreachCase" as breach
control ":RemedyFinalized\nConsumer" as fanout

inspector -> page : submitReport(metrics, file)
page -> ctl ++ : submitReport(id, req)
ctl -> submit ++ : execute(cmd)
submit -> submit : computeHashes(result)
create entity ":Inspection\nReport" as report
submit -> report : <<create>> InspectionReport(assignment, result)
submit -> assignment ++ : end()
assignment --> submit --
submit -> mq : publish(inspection.report_confirmed)
submit --> ctl --
ctl --> page -- : 201
page --> inspector : MSG96

mq -> cons ++ : on(inspection.report_confirmed)
cons -> apply ++ : execute(cmd)
apply -> apply : verifyResultHash(result)
apply -> qdc ++ : evaluate(spec, metrics)
qdc --> apply -- : disposition
create entity ":Attribution\nDecision" as attribution
apply -> attribution : <<create>> AttributionDecision(INSPECTOR_L1_5, role, disposition)
apply -> rc ++ : calculate(attribution, legalProfile)
rc --> apply -- : remedyDecision with legs
apply -> breach ++ : resolve(attribution)
breach --> apply --
apply -> mq : publish(remedy.finalized)
apply --> cons --
cons --> mq -- : ack

par escrow-service and reputation-service
  mq -> fanout ++ : on(remedy.finalized)
  fanout --> mq -- : ack
end
@enduml
