@startuml fig11_seq_money_reconcile
!include vp-style.iuml
autonumber "0:"
hide footbox

boundary ":Message\nBroker" as mq
control ":MilestoneSettled\nConsumer" as cons
entity ":ProcessedEvent\nStore" as dedup
control ":ReleaseMilestone\nFundsUseCase" as release
control ":ProcessBank\nCommandUseCase" as bankuc
entity ":SystemLock" as lock
control ":Completion\nReconciler" as recon
entity ":MilestoneSync\nOutbox" as msync
boundary ":BankLedger\nQueryPort" as ledgerport
entity ":Contract" as contract

mq -> cons ++ : on(milestone.settled)
cons -> dedup ++ : markProcessed(consumer, eventId)
dedup --> cons -- : true
cons -> release ++ : execute(cmd)
release -> mq : publish(bank.release_requested)
release -> mq : publish(bank.refund_requested)
release --> cons --
cons --> mq -- : ack

mq -> bankuc ++ : execute(bank.release_requested)
bankuc -> lock ++ : isActive()
lock --> bankuc -- : false
create entity ":LedgerEntry" as ledger
bankuc -> ledger : <<create>> LedgerEntry(command)
bankuc -> mq : publish(bank.release_completed)
deactivate bankuc

== after the last milestone is SETTLED ==
recon -> recon ++ : run()
recon -> msync ++ : nextUnprocessed()
msync --> recon -- : milestoneIds
create entity ":RemedyDecision" as remedy
recon -> remedy : <<create>> RemedyDecision(noFaultAttribution, depositReturnLegs)
recon -> mq : publish(remedy.finalized)
recon -> ledgerport ++ : entriesOf(contractId)
ledgerport --> recon -- : ledger entries
recon -> recon : expectedLegsComplete(entries)
opt every expected leg exists and remaining lock = 0
  recon -> contract ++ : transitionTo(SETTLED)
  contract --> recon --
  recon -> mq : publish(contract.settled)
end
deactivate recon
@enduml
