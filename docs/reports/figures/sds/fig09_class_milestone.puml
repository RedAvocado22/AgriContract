@startuml fig09_class_milestone
!include vp-style.iuml

package "contract-service" {
  class MilestonePage <<boundary>> {
    + recordWeighing(weight : Quantity, evidence : File) : void
    + confirmClean(weight : Quantity, evidence : File) : void
  }
  class MilestoneController <<control>> {
    + weigh(mid : UUID, req : WeighRequest) : void
    + confirm(mid : UUID, req : ConfirmRequest) : void
  }
  class RecordSellerWeighedUseCase <<control>> {
    + execute(cmd : RecordWeighCommand) : void
  }
  class ConfirmMilestoneCleanUseCase <<control>> {
    + execute(cmd : ConfirmCleanCommand) : void
  }
  class SettlementCalculator <<control>> {
    + compute(terms : ContractTerms, seller : Quantity, buyer : Quantity) : Settlement
  }
  class CompletionReconciler <<control>> {
    + run() : void
    - expectedLegsComplete(entries : List<LedgerEntryView>) : boolean
  }
  interface BankLedgerQueryPort <<boundary>> {
    + entriesOf(contractId : UUID) : List<LedgerEntryView>
  }
  class Milestone <<entity>> {
    - milestoneId : UUID
    - status : MilestoneStatus
    - batchAmount : Money
    - sellerDeclaredWeight : Quantity
    - buyerReceivedWeight : Quantity
    + recordSellerWeighed(weight : Quantity, evidence : UUID) : void
    + recordBuyerReceived(weight : Quantity, evidence : UUID) : void
    + settle(settlement : Settlement) : void
  }
  class MilestoneSyncOutbox <<entity>> {
    + add(milestoneId : UUID) : void
    + nextUnprocessed() : List<UUID>
  }
  class RemedyDecision <<entity>> {
    + RemedyDecision(attribution : AttributionDecision, legs : List<RemedyLeg>)
  }
  class Contract <<entity>> {
    + transitionTo(next : ContractStatus) : void
  }
  class EventOutbox <<entity>> {
    + write(event : EventEnvelope) : void
  }
}

interface MessageBroker <<boundary>> {
  + publish(event : EventEnvelope) : void
}

package "escrow-service" {
  class MilestoneSettledConsumer <<control>> {
    + on(event : Map) : void
  }
  class ReleaseMilestoneFundsUseCase <<control>> {
    + execute(cmd : ReleaseFundsCommand) : void
  }
  class ProcessedEventStore <<entity>> {
    + markProcessed(consumer : String, eventId : UUID) : boolean
  }
}

package "bank-service" {
  class ProcessBankCommandUseCase <<control>> {
    + execute(command : BankCommand) : void
  }
  class SystemLock <<entity>> {
    + isActive() : boolean
  }
  class LedgerEntry <<entity>> {
    - sourceEventId : UUID
    - entryType : EntryType
    - fundType : FundType
    - amount : Money
    + LedgerEntry(command : BankCommand)
  }
}

MilestonePage --> MilestoneController
MilestoneController --> RecordSellerWeighedUseCase
MilestoneController --> ConfirmMilestoneCleanUseCase
RecordSellerWeighedUseCase --> Milestone
RecordSellerWeighedUseCase --> EventOutbox
ConfirmMilestoneCleanUseCase --> Milestone
ConfirmMilestoneCleanUseCase --> SettlementCalculator
ConfirmMilestoneCleanUseCase --> EventOutbox
ConfirmMilestoneCleanUseCase --> MilestoneSyncOutbox
CompletionReconciler --> MilestoneSyncOutbox
CompletionReconciler --> BankLedgerQueryPort
CompletionReconciler ..> RemedyDecision : <<create>>
CompletionReconciler --> Contract
CompletionReconciler --> MessageBroker : publishes
MilestoneSettledConsumer --> MessageBroker : consumes
MilestoneSettledConsumer --> ProcessedEventStore
MilestoneSettledConsumer --> ReleaseMilestoneFundsUseCase
ReleaseMilestoneFundsUseCase --> MessageBroker : publishes
ProcessBankCommandUseCase --> SystemLock
ProcessBankCommandUseCase ..> LedgerEntry : <<create>>
ProcessBankCommandUseCase --> MessageBroker : consumes / publishes
SettlementCalculator -[hidden]-> CompletionReconciler
Milestone -[hidden]-> CompletionReconciler
Contract -[hidden]-> MilestoneSettledConsumer
RemedyDecision -[hidden]-> ProcessBankCommandUseCase
@enduml
