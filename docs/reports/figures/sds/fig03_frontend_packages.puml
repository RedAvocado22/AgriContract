@startuml fig03_frontend_packages
!include vp-style.iuml
set separator ::

package "frontend/src" {
  package routes
  package features {
    package auth
    package listings
    package contracts {
      package api
      package hooks
      package components
      package lib
    }
    package escrow
    package notifications
  }
  package shared {
    package ui
    package api
    package hooks
    package lib
  }
}

"frontend/src::routes" ..> "frontend/src::features" : <<access>>
"frontend/src::features::contracts::components" ..> "frontend/src::features::contracts::hooks" : <<access>>
"frontend/src::features::contracts::hooks" ..> "frontend/src::features::contracts::api" : <<access>>
"frontend/src::features::contracts::components" ..> "frontend/src::features::contracts::lib" : <<access>>
"frontend/src::features::contracts::api" ..> "frontend/src::shared::api" : <<import>>
"frontend/src::features::contracts::components" ..> "frontend/src::shared::ui" : <<import>>

@enduml
