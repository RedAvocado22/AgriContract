@startuml fig02_backend_packages
!include vp-style.iuml
set separator ::

package "com.agricontract.contract" {
  package infrastructure {
    package web
    package messaging
    package persistence
    package client
    package config
  }
  package application {
    package usecase
    package port
    package dto
    package exception
  }
  package domain {
    package model
    package service
    package event
    package repository
    package exception
  }
}

package "com.agricontract.eventing" {
}

"com.agricontract.contract::infrastructure::web" ..> "com.agricontract.contract::application::usecase" : <<access>>
"com.agricontract.contract::infrastructure::messaging" ..> "com.agricontract.contract::application::usecase" : <<access>>
"com.agricontract.contract::application::usecase" ..> "com.agricontract.contract::domain::model" : <<access>>
"com.agricontract.contract::application::usecase" ..> "com.agricontract.contract::domain::repository" : <<access>>
"com.agricontract.contract::application::usecase" ..> "com.agricontract.contract::application::port" : <<access>>
"com.agricontract.contract::infrastructure::persistence" ..> "com.agricontract.contract::domain::repository" : <<import>>
"com.agricontract.contract::infrastructure::client" ..> "com.agricontract.contract::application::port" : <<import>>
"com.agricontract.contract::application::usecase" ..> "com.agricontract.eventing" : <<import>>
@enduml
