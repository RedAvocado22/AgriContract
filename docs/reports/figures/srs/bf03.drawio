<mxfile host="vpdiagram.py"><diagram name="bf03" id="bf03"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="780" pageHeight="1075"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Buyer" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="170" height="1075" as="geometry"/></mxCell><mxCell id="lane1" value="Seller" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="170" y="0" width="170" height="1075" as="geometry"/></mxCell><mxCell id="lane2" value="System" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="0" width="270" height="1075" as="geometry"/></mxCell><mxCell id="lane3" value="Operator" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="0" width="170" height="1075" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="73.0" y="40.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="a1" value="1. Choose a listing&lt;br&gt;and create an offer" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="7.0" y="76.0" width="156" height="48.0" as="geometry"/></mxCell><mxCell id="a2" value="2. Validate the terms and&lt;br&gt;reserve the listing quantity" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="360.0" y="76.0" width="230" height="48.0" as="geometry"/></mxCell><mxCell id="a3" value="3. Review and revise&lt;br&gt;the terms (either&lt;br&gt;party)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="177.0" y="143.5" width="156" height="63.0" as="geometry"/></mxCell><mxCell id="d1" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240.0" y="220.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a4" value="4. Withdraw the offer&lt;br&gt;(either party, before&lt;br&gt;the second signature)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="177.0" y="268.5" width="156" height="63.0" as="geometry"/></mxCell><mxCell id="a5" value="5. Mark WITHDRAWN, release&lt;br&gt;the quantity, notify the&lt;br&gt;other party" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="360.0" y="268.5" width="230" height="63.0" as="geometry"/></mxCell><mxCell id="f1" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="462.0" y="347.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="fork" value="" style="shape=line;strokeWidth=6;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="382.0" width="300" height="6" as="geometry"/></mxCell><mxCell id="a6" value="6. Sign the terms&lt;br&gt;with an e-mail OTP" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="7.0" y="411.0" width="156" height="48.0" as="geometry"/></mxCell><mxCell id="a7" value="7. Sign the same&lt;br&gt;terms with an&lt;br&gt;e-mail OTP" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="177.0" y="403.5" width="156" height="63.0" as="geometry"/></mxCell><mxCell id="n1" value="Either party may sign first;&lt;br&gt;both signatures must be on&lt;br&gt;the same terms fingerprint" style="shape=note;size=10;align=left;spacingLeft=8;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="362.5" y="404.5" width="225" height="61.0" as="geometry"/></mxCell><mxCell id="join" value="" style="shape=line;strokeWidth=6;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="492.0" width="300" height="6" as="geometry"/></mxCell><mxCell id="a8" value="8. Check both signatures&lt;br&gt;match the terms (SIGNED)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="360.0" y="521.0" width="230" height="48.0" as="geometry"/></mxCell><mxCell id="a9" value="9. Ask the bank to lock both&lt;br&gt;deposits (automatic retries)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="360.0" y="586.0" width="230" height="48.0" as="geometry"/></mxCell><mxCell id="d2" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="460.0" y="655.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a10" value="10. Activate the contract&lt;br&gt;(ACTIVE)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="375.0" y="706.0" width="200" height="48.