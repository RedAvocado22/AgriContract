<mxfile host="vpdiagram.py"><diagram name="bf05" id="bf05"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1140" pageHeight="1430"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Buyer / Seller" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="1430" as="geometry"/></mxCell><mxCell id="lane1" value="Arbitrator" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="0" width="260" height="1430" as="geometry"/></mxCell><mxCell id="lane2" value="Inspector" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="240" height="1430" as="geometry"/></mxCell><mxCell id="lane3" value="System" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="0" width="340" height="1430" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="138.0" y="58.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="a1" value="1. Report a breach or&lt;br&gt;claim force majeure" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50.0" y="116.0" width="200" height="48.0" as="geometry"/></mxCell><mxCell id="n1" value="Or the System detects a missed&lt;br&gt;obligation, e.g. funding not cured" style="shape=note;size=10;align=left;spacingLeft=8;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="25.0" y="212.0" width="250" height="46.0" as="geometry"/></mxCell><mxCell id="a2" value="2. Record the case and&lt;br&gt;notify the other party" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860.0" y="116.0" width="220" height="48.0" as="geometry"/></mxCell><mxCell id="n2" value="No penalty on&lt;br&gt;an allegation" style="shape=note;size=10;align=left;spacingLeft=8;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="950.0" y="212.0" width="140" height="46.0" as="geometry"/></mxCell><mxCell id="a3" value="3. Review the evidence&lt;br&gt;against the signed terms" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="325.0" y="296.0" width="210" height="48.0" as="geometry"/></mxCell><mxCell id="d1" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="415.0" y="385.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a4" value="4. Request an inspection&lt;br&gt;per the signed terms" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="335.0" y="456.0" width="190" height="48.0" as="geometry"/></mxCell><mxCell id="a5" value="5. Inspect and&lt;br&gt;submit a report" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="590.0" y="456.0" width="180" height="48.0" as="geometry"/></mxCell><mxCell id="m1" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="415.0" y="565.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a6" value="6. Record the breaching party&lt;br&gt;and the evidence used" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315.0" y="636.0" width="230" height="48.0" as="geometry"/></mxCell><mxCell id="a7" value="7. Notify the parties and open&lt;br&gt;the 2-business-day contest&lt;br&gt;window" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="845.0" y="628.5" width="250" height="63.0" as="geometry"/></mxCell><mxCell id="n3" value="Penalty, forfeiture and&lt;br&gt;lock wait; no-fault&lt;br&gt;refunds run at once" style="shape=note;size=10;align=left;spacingLeft=8;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="580.0" y="719.5" width="200" height="61.0" as="geometry"/></mxCell><mxCell id="d2" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="955.0" y="825.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a8" value="8. Submit a contest&lt;br&gt;with evidence" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50.0" y="816.0" width="200" height="48.0" as="geometry"/></mxCell><mxCell id="a9" value="9. Level 1.5 reviews the&lt;br&gt;case; the decision is final" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="570.0" y="906.0" width="220" height="48.0" as="geometry"/></mxCell><mxCell id="n4" value="Not