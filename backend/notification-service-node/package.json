{
  "name": "notification-service-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/mysql": "^12.2.1",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
