meta {
  name: 24. OTP email without X-Internal-Secret is rejected (401)
  type: http
  seq: 24
}

post {
  url: {{notification_service_url}}/internal/v1/notifications/otp-email
  body: json
  auth: none
}

body:json {
  {
    "requestId": "otp-no-secret",
    "recipientUserId": "{{buyer1_sub}}",
    "recipientEmail": "{{buyer1_email}}",
    "contractId": "notif-otp-no-secret",
    "otpCode": "123456",
    "signedContentHash": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
    "expiresAt": "2026-11-04T10:15:00Z"
  }
}

tests {
  test("401 UNAUTHORIZED in the shared error envelope", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("UNAUTHORIZED");
    expect(res.getBody()).to.have.all.keys("timestamp", "status", "error", "code", "message", "path", "traceId");
  });
}
