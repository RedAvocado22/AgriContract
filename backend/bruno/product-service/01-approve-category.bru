meta {
  name: PUT /api/v1/admin/categories/:categoryId/approve
  type: http
  seq: 1
}

put {
  url: {{product_service_url}}/api/v1/admin/categories/{{category_id}}/approve
  body: json
  auth: none
}

headers {
  X-Gateway-Secret: {{gateway_secret}}
  X-User-Id: operator-1
  X-User-Role: OPERATOR
}

body:json {
  {
    "commodity": "COFFEE"
  }
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("status should be APPROVED", function() {
    expect(res.getBody().status).to.equal("APPROVED");
  });

  test("approval stores the commodity the Operator assigned", function() {
    expect(res.getBody().commodity).to.equal("COFFEE");
  });
}
