meta {
  name: PUT /api/v1/admin/categories/:categoryId/commodity (already mapped)
  type: http
  seq: 2
}

put {
  url: {{product_service_url}}/api/v1/admin/categories/{{category_id}}/commodity
  body: json
  auth: none
}

headers {
  X-Gateway-Secret: {{gateway_secret}}
  X-User-Id: operator-1
  X-User-Role: OPERATOR
}

body:json {
  {
    "commodity": "COFFEE"
  }
}

tests {
  // only categories approved before V7 (commodity NULL) can be mapped; approval already mapped this one
  test("should return 409", function() {
    expect(res.getStatus()).to.equal(409);
  });

  test("error body is the shared ErrorEnvelope", function() {
    expect(res.getBody().code).to.be.a("string");
    expect(res.getBody().traceId).to.be.a("string");
  });
}
