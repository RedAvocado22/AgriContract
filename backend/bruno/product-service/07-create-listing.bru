meta {
  name: POST /api/v1/listings (create listing)
  type: http
  seq: 8
}

post {
  url: {{product_service_url}}/api/v1/listings
  body: json
  auth: none
}

headers {
  X-Gateway-Secret: {{gateway_secret}}
  X-User-Id: {{seller1_sub}}
  X-User-Role: SELLER
  Idempotency-Key: {{create_listing_key}}
}

body:json {
  {
    "productId": "{{product_id}}",
    "productName": "Ca phe Robusta Dak Lak",
    "unitOfMeasure": "KG",
    "offeredQuantity": 500,
    "minOrderQuantity": 100,
    "askingUnitPrice": "15000.00",
    "registryEntryIds": ["{{plot_id}}"],
    "regionText": "Buon Ma Thuot, Dak Lak",
    "declaredQualitySpec": {
      "commodity": "COFFEE",
      "type": "ROBUSTA",
      "moisturePercent": 12.5,
      "foreignMatterPercent": 0.5,
      "blackBrokenBeansPercent": 5.0
    },
    "packagingDeclaration": "Bao day 60 kg"
  }
}

script:pre-request {
  // one key per run; 07b replays it, so it must survive until then
  bru.setVar("create_listing_key", "listing-" + Date.now() + "-" + Math.random().toString(36).slice(2));
  // the plot from 06b is PENDING until the geo check timeout; run product-service with
  // PLOT_GEO_VERIFICATION_TIMEOUT_HOURS=0 and PLOT_GEO_VERIFICATION_TIMEOUT_CHECK_MS=1000, then give the job a moment
  await new Promise((resolve) => setTimeout(resolve, 1500));
}

script:post-response {
  const listingId = res.getBody()?.listingId;
  if (listingId) {
    bru.setEnvVar("listing_id", listingId);
  }
}

tests {
  test("should return 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("should return listingId", function() {
    expect(res.getBody().listingId).to.be.a("string");
  });

  test("sellerId should match header", function() {
    expect(res.getBody().sellerId).to.equal(bru.getEnvVar("seller1_sub"));
  });

  test("productName snapshot should be set", function() {
    expect(res.getBody().productName).to.equal("Ca phe Robusta Dak Lak");
  });

  test("contract field names: kg quantities, 2-decimal VND/kg price, no Phase 1 fields", function() {
    const data = res.getBody();
    expect(data.unitOfMeasure).to.equal("KG");
    expect(data.offeredQuantity).to.equal(500);
    expect(data.quantityAvailable).to.equal(500);
    expect(data.askingUnitPrice).to.equal("15000.00");
    expect(data).to.not.have.property("priceFloor");
    expect(data).to.not.have.property("deliveryDeadline");
    expect(data).to.not.have.property("coverImageUrl");
  });

  test("status should be AVAILABLE", function() {
    expect(res.getBody().status).to.equal("AVAILABLE");
  });

  test("coffee goods: commodity from the category, season from the product, declared quality", function() {
    const data = res.getBody();
    expect(data.commodity).to.equal("COFFEE");
    expect(data.categoryId).to.equal(bru.getEnvVar("category_id"));
    expect(data.cropYear).to.equal(2026);
    expect(data.declaredQualitySpec.type).to.equal("ROBUSTA");
    expect(data.legacyQualitySpecMissing).to.equal(false);
  });

  test("listing names the registry plot it comes from", function() {
    expect(res.getBody().registryEntryIds).to.deep.equal([bru.getEnvVar("plot_id")]);
  });
}
