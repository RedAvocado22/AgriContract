meta {
  name: POST /api/v1/listings (create listing)
  type: http
  seq: 8
}

post {
  url: {{product_service_url}}/api/v1/listings
  body: json
  auth: none
}

headers {
  X-Gateway-Secret: {{gateway_secret}}
  X-User-Id: {{seller1_sub}}
  X-User-Role: SELLER
}

body:json {
  {
    "productId": "{{product_id}}",
    "quantity": 500,
    "quantityUnit": "kg",
    "priceFloor": 15000.00,
    "currency": "VND",
    "deliveryDeadline": "2026-09-30",
    "registryEntryIds": ["{{plot_id}}"],
    "regionText": "Buon Ma Thuot, Dak Lak",
    "declaredQualitySpec": {
      "commodity": "COFFEE",
      "type": "ROBUSTA",
      "moisturePercent": 12.5,
      "foreignMatterPercent": 0.5,
      "blackBrokenBeansPercent": 5.0
    },
    "packagingDeclaration": "Bao day 60 kg"
  }
}

script:pre-request {
  // the plot from 06b is PENDING until the geo check timeout; run product-service with
  // PLOT_GEO_VERIFICATION_TIMEOUT_HOURS=0 and PLOT_GEO_VERIFICATION_TIMEOUT_CHECK_MS=1000, then give the job a moment
  await new Promise((resolve) => setTimeout(resolve, 1500));
}

script:post-response {
  const listingId = res.getBody()?.data?.listingId;
  if (listingId) {
    bru.setEnvVar("listing_id", listingId);
  }
}

tests {
  test("should return 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("success flag is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("should return listingId", function() {
    expect(res.getBody().data.listingId).to.be.a("string");
  });

  test("sellerId should match header", function() {
    expect(res.getBody().data.sellerId).to.equal(bru.getEnvVar("seller1_sub"));
  });

  test("productName snapshot should be set", function() {
    expect(res.getBody().data.productName).to.equal("Ca phe Robusta Dak Lak");
  });

  test("coverImageUrl snapshot should be product's first image", function() {
    expect(res.getBody().data.coverImageUrl).to.equal("https://cdn.agricontract.test/products/ca-phe-robusta-1.jpg");
  });

  test("status should be ACTIVE", function() {
    expect(res.getBody().data.status).to.equal("ACTIVE");
  });

  test("coffee goods: commodity from the category, season from the product, declared quality", function() {
    const data = res.getBody().data;
    expect(data.commodity).to.equal("COFFEE");
    expect(data.categoryId).to.equal(bru.getEnvVar("category_id"));
    expect(data.cropYear).to.equal(2026);
    expect(data.declaredQualitySpec.type).to.equal("ROBUSTA");
    expect(data.legacyQualitySpecMissing).to.equal(false);
  });

  test("listing names the registry plot it comes from", function() {
    expect(res.getBody().data.registryEntryIds).to.deep.equal([bru.getEnvVar("plot_id")]);
  });
}
