meta {
  name: GET /api/v1/users/:userId (slim — no PII)
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/users/{{registered_user_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{seller_token}}
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body is not wrapped in ApiResponse", function() {
    expect(res.getBody().data).to.equal(undefined);
  });

  test("userId matches", function() {
    expect(res.getBody().userId).to.equal(bru.getEnvVar("registered_user_id"));
  });

  test("organizationName is set", function() {
    expect(res.getBody().organizationName).to.be.a("string");
  });

  test("role is present", function() {
    expect(res.getBody().role).to.be.a("string");
  });

  test("verificationStatus is present", function() {
    expect(res.getBody().verificationStatus).to.be.a("string");
  });

  test("email is not exposed (#108, services use /internal/v1/users)", function() {
    expect(res.getBody().email).to.equal(undefined);
  });

  test("phone is not exposed (IDOR fix)", function() {
    expect(res.getBody().phone).to.equal(undefined);
  });

  test("address is not exposed (IDOR fix)", function() {
    expect(res.getBody().address).to.equal(undefined);
  });
}
