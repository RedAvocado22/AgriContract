meta {
  name: GET /api/v1/users/me
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{seller_token}}
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body is not wrapped in ApiResponse", function() {
    expect(res.getBody().data).to.equal(undefined);
  });

  test("userId matches registered_user_id", function() {
    expect(res.getBody().userId).to.equal(bru.getEnvVar("registered_user_id"));
  });

  test("full profile includes phone and address", function() {
    expect(res.getBody().phone).to.be.a("string");
    expect(res.getBody().address).to.be.a("string");
  });
}
