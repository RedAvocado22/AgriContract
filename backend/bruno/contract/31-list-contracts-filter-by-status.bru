meta {
  name: 31. List Contracts (filter by status=OFFERED)
  type: http
  seq: 31
}

get {
  url: {{base_url}}/api/v1/contracts?status=OFFERED&page=0&size=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{buyer_token}}
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("should return paginated response", function() {
    const data = res.getBody();
    expect(data).to.have.property("content");
    expect(data).to.have.property("totalElements");
  });
  test("all returned contracts should have status OFFERED", function() {
    const contracts = res.getBody().content;
    contracts.forEach(c => {
      expect(c.status).to.equal("OFFERED");
    });
  });
}
